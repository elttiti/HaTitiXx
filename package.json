{
  "name": "hatitix",
  "version": "0.1.0",
  "description": "Cliente de escritorio de Haxball: haTitix",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MPL-2.0",
  "dependencies": {
    "node-haxball": "^2.3.1"
  },
  "devDependencies": {
    "electron": "^45.2.2"
  },
  "author": "HaTitiX",
  "build": {
    "appId": "com.hatitix.app",
    "productName": "HaTitiX",
    "asar": true,
    "files": [
      "**/*",
      "!relay-server/**",
      "!dist-win/**",
      "!HaTitiX.exe",
      "!*.bat"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "hatitix-icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "HaTitiX-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "HaTitiX-Portable-${version}.${ext}"
    },
    "directories": {
      "output": "dist-win"
    }
  }
}
